# Copy to .env and fill in. Used by docker-compose.
# Generate a secret: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Origin allowed to call the API. Comma-separate for multiple.
CORS_ORIGIN=http://localhost:8080

# Optional — AI categorization and insights are disabled without this.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Must support strict structured outputs: openai/gpt-oss-120b or openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
