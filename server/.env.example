# Copy to server/.env for local (non-Docker) development.
NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expense_tracker

# Generate a secret: openssl rand -base64 48
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Optional — AI features are disabled without this.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Must support strict structured outputs: openai/gpt-oss-120b or openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
