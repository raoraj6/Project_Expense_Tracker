{
  "name": "expense-tracker-server",
  "version": "1.0.0",
  "description": "Express + MongoDB API for the Expense Tracker",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "dev:mem": "node scripts/dev-mem.js",
    "start": "node src/index.js",
    "seed": "node src/utils/seed.js",
    "test": "NODE_ENV=test node --test --experimental-test-coverage tests/*.test.js",
    "lint": "eslint src tests"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "groq-sdk": "^0.30.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "morgan": "^1.10.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0"
  }
}
